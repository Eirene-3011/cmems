# ── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (MySQL / XAMPP defaults) ───────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cmems_db

# ── JWT ─────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_string_at_least_32_chars
JWT_EXPIRES_IN=24h

# ── CORS ────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
